# ============================================================
# AutoBrain environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Core ---
PROJECT_NAME=AutoBrain
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- PostgreSQL ---
POSTGRES_USER=autobrain
POSTGRES_PASSWORD=autobrain
POSTGRES_DB=autobrain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://autobrain:autobrain@postgres:5432/autobrain

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=autobrain
MINIO_SECRET_KEY=autobrain
MINIO_BUCKET=autobrain-assets
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AI Router (9Router) ---
# All AI modules route inference through this URL.
# Set to your 9Router instance. If unreachable, local rule-based
# fallbacks are used (see ai/app/router_client.py).
AI_ROUTER_URL=http://your-9router-instance:port
AI_ROUTER_API_KEY=
AI_ROUTER_TIMEOUT_SECONDS=60
# Local fallback model inference endpoint for offline / self-hosted mode
AI_LOCAL_BASE_URL=http://ai:8001

# --- Frontend (build args) ---
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000/ws

# --- Rego lookup (optional, external provider) ---
REGO_LOOKUP_URL=
REGO_LOOKUP_API_KEY=

# --- Resale market data (optional, external provider) ---
MARKET_DATA_URL=
MARKET_DATA_API_KEY=
