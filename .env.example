# ============================================================
# AutoBrain environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Core ---
PROJECT_NAME=AutoBrain
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- LAN exposure (dev compose only) ---
# Set EXPOSE_LAN=1 to lift the 127.0.0.1 binding on backend (8000), AI gateway (8001),
# and frontend (8080) so a phone/tablet on the same LAN can hit the stack
# (mobile/QR testing). Default 0 keeps everything on localhost.
# Only switches backend/ai/frontend. Postgres/Redis/MinIO stay 127.0.0.1 always.
# Also requires a host firewall rule to permit inbound on these ports from your
# LAN subnet — see docs/deployment-guide.md ("LAN testing (mobile/QR)").
EXPOSE_LAN=0

# --- Docker Hub (production, image namespace/tag) ---
# Your app.docker.com username. Used by scripts/publish-images.sh and
# docker-compose.prod.yml. Never leave blank in production.
DOCKERHUB_USERNAME=cannonfodder151
IMAGE_TAG=latest

# --- Security ---
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Placeholders are refused outside development (development gets an ephemeral key).
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- PostgreSQL ---
POSTGRES_USER=change-me-postgres-user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=autobrain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://change-me-postgres-user:change-me-postgres-password@postgres:5432/autobrain

# --- Redis ---
# Required (AB-INFRA-004): dev Redis requires auth. Embedded in all redis:// URLs.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- MinIO (S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=autobrain-assets
MINIO_SECURE=false
# Externally reachable base for presigned object URLs (AUT-321). Point at the
# frontend nginx (which proxies /autobrain-assets/ to MinIO and preserves the
# signed Host header), e.g. the dev frontend port below. MinIO itself must
# never be published with anonymous read.
MINIO_PUBLIC_ENDPOINT=http://localhost:8080

# --- Celery ---
CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/2

# --- AI Router (9Router) ---
# Corporate 9Router; base IP is http://10.0.3.17:20128/v1 (LAN). On the Oracle
# hosted stack the env is overridden to the stack-local 9router (10.0.3.17 is
# unreachable from Oracle Cloud) — see docker-compose.hosted.yml. All AI modules
# route inference through this URL (OpenAI-compatible). If unreachable, local
# rule-based fallbacks run instead (see ai/app/router_client.py).
AI_ROUTER_URL=http://10.0.3.17:20128/v1
AI_ROUTER_API_KEY=
# Model id served by the router (check GET /v1/models on your instance).
AI_ROUTER_MODEL=General-Use
AI_ROUTER_TIMEOUT_SECONDS=120
# Embedding model for vector semantic search (used by pgvector).
# Must be an OpenAI-compatible /embeddings model served by the router.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Local fallback model inference endpoint for offline / self-hosted mode
AI_LOCAL_BASE_URL=http://ai:8001
# Shared bearer key backend -> AI gateway (must match between the two services).
# Required everywhere now (AB-INFRA-006): dev compose refuses to start without
# it, and the gateway rejects /v1 calls (401) when it is empty. Hosted and prod
# compose already required it (`${AI_GATEWAY_API_KEY:?}`).
AI_GATEWAY_API_KEY=change-me-ai-gateway-key
# Per-user AI usage caps (Redis-backed, enforced in the backend before any
# 9Router spend; 429 on exceed). Burst = max calls per fixed window.
AI_RATE_LIMIT_PER_WINDOW=10
AI_RATE_WINDOW_SECONDS=60
AI_DAILY_LIMIT=50
# Gateway-side burst caps (in-memory, per client IP + global). Defense in depth;
# defaults sit above the daily fleet-valuation refresh so legit traffic passes.
AI_GATEWAY_RATE_LIMIT_PER_WINDOW=600
AI_GATEWAY_GLOBAL_RATE_LIMIT_PER_WINDOW=6000
AI_GATEWAY_RATE_WINDOW_SECONDS=60

# --- Frontend (build args) ---
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000/ws

# --- Rego lookup (self-hosted Plate-API-Scraper) ---
# Real AU registry lookups via your own scraper (no paid provider).
# Request format: POST {REGO_LOOKUP_URL}  body {"plate","state"}  header X-API-Key
REGO_LOOKUP_URL=http://localhost:8011/lookup
REGO_LOOKUP_API_KEY=
# NOTE: lookups run on demand (only when the user taps Lookup), and the
# offline heuristic still kicks in if the provider fails or is unreachable.

# --- 7-Eleven fuel prices (projectzerothree.info) ---
# Public, keyless, server-cached snapshot of every 7-Eleven store's best price.
# Deterministic, no AI. Override only to point at a self-hosted mirror.
SEVEN_ELEVEN_API_URL=https://projectzerothree.info/api.php?format=json
SEVEN_ELEVEN_CACHE_TTL_MINUTES=60

# --- Bootstrap admin (created on first boot if missing) ---
# Set a strong password here; rotate it after first login.
ADMIN_EMAIL=admin@autobrain.local
ADMIN_DISPLAY_NAME=AutoBrain Admin
ADMIN_INITIAL_PASSWORD=

# --- Demo mode (read-only demo account + sample data) ---
# When DEMO_MODE=true the app seeds a read-only demo user with sample
# vehicles/services/fuel/parts/mods. The demo role is enforced server-side:
# all write endpoints and all AI modules return 403 for demo accounts.
DEMO_MODE=false
DEMO_EMAIL=demo@autobrainservice.app
DEMO_PASSWORD=demo
DEMO_DISPLAY_NAME=Demo Garage

# --- SMTP (email notifications + self-service password reset) ---
# STARTTLS when SMTP_USE_TLS=true (typical for port 587 / 25). Leave
# SMTP_USERNAME/PASSWORD empty for anonymous relay (e.g. MS365 connector).
SMTP_HOST=
SMTP_PORT=25
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AutoBrain
# Recipient suppression (AUT-1167): comma-separated list of domains to never
# email (RFC 2606 reserved + throwaway test domains). Regex patterns matching
# the local-part are also checked; the defaults block smoke-test, deploy-test,
# QA-verification, and fake user-addresses created by automated test runs.
EMAIL_SUPPRESS_DOMAINS=example.com,example.org,example.net,test,invalid,testmail.com
EMAIL_SUPPRESS_PATTERNS=^(?:smoke(?:hst\d*|[-_.]?(?:aut)?\d)|deploy[-_.]?(?:test[-_.-])?(?:aut|test)\d|aut\d+[-_.](?:check|host|test)|qa[-_.](?:verify|license))
# Public base URL used to build password-reset links (no trailing slash)
APP_BASE_URL=http://localhost:8000

# --- CI Triage webhook (AUT-1669) ---
# Bearer auth secret matching CI_TRIAGE_WEBHOOK_SECRET in GitHub Actions.
CI_TRIAGE_WEBHOOK_SECRET=
CI_TRIAGE_PARENT_ISSUE_ID=
CI_TRIAGE_GOAL_ID=
CI_TRIAGE_AGENT_ID=acae6bf2
# Paperclip API for creating child issues from the webhook.
PAPERCLIP_API_URL=https://paperclip.nathanmartina.com
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=

# --- Resale market data (optional, external provider) ---
MARKET_DATA_URL=
MARKET_DATA_API_KEY=

# --- Servo Spy fuel price map (AUT-1813/1817, optional, PREMIUM-GATED) ---
# Deterministic, no-AI ingest of public open-data fuel prices into Postgres
# (fuel_stations + fuel_prices), exposed at /api/fuel/* (premium only).
# WA FuelWatch  : public, no key required.
# NSW FuelCheck : https://api.transport.nsw.gov.au — free key from api.transport.nsw.gov.au
#                 (registered as the FuelCheck API key; used as the `apikey` header).
# QLD Fuel Prices : public open data (best-effort field mapping; see service).
# WA/QLD URLs can be overridden for self-hosting a mirror. WA+NSW+QLD+ACT cover
# ~63% of AU; VIC/SA/TAS/NT need a paid aggregator (Informed Sources / MotorMouth),
# a later premium enhancement — not MVP. See docs/fuel-servo-spy.md.
FUEL_NSW_API_KEY=
FUEL_NSW_API_SECRET=
FUEL_NSW_ENABLED=false
FUEL_NSW_URL=https://api.transport.nsw.gov.au/v1/fuel
FUEL_WA_SITES_URL=https://industryprd.fuelwatch.wa.gov.au/api/sites
FUEL_WA_PRICES_URL=https://industryprd.fuelwatch.wa.gov.au/api/report/weekly-retail-prices
FUEL_QLD_API_URL=https://www.fuelpricesqld.com.au/
FUEL_INGEST_USER_AGENT=AutoBrain Servo Spy (+https://autobrainservice.app)

# --- Versioning (local only) ---
# Server version string shown in admin settings. The GitHub update check was
# removed (AUT-461); the server makes no GitHub API calls.
APP_VERSION=0.3.4

# --- Scheduled backup (admin) ---
# Daily full-DB JSON snapshot stored to MinIO under backups/, pruned after
# BACKUP_RETENTION_DAYS. Run manually from Admin > Backup & restore.
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14

# --- Admin API key (machine-to-machine user management) ---
# Enables /api/v1/admin-api/* endpoints, authenticated with the
# X-Admin-API-Key header. Leave empty to disable.
ADMIN_API_KEY=

# --- Dongle-server backchannel (AUT-1673) ---
# Shared secret the backend and the dongle-server exchange as X-Internal-Api-Key.
# The dongle-server calls POST /devices/verify here to check paid status at the
# device edge; the backend calls the dongle-server's /_internal/whitelist to
# push serial whitelist entries for paid accounts. Leave empty to disable.
DONGLE_SERVER_API_KEY=
DONGLE_SERVER_URL=

# --- CORS allowed origins (JSON list, default same-origin only) ---
# Explicit allow-list of browser origins that may call the API cross-origin.
# The nginx frontend proxies /api,/ws,/ai same-origin, so most deployments can
# leave this empty. Set it only when a browser client calls the API directly
# from a different origin, e.g.:
#   CORS_ALLOWED_ORIGINS=["https://app.example.com"]
CORS_ALLOWED_ORIGINS=[]

# --- Hosted instance: self-service signup ---
# When true, anyone can register a Free-tier account via POST /auth/signup
# (role=user, free_account=true, max_vehicles=1). The signup form/button is
# hidden in the app when this is false (served by GET /auth/config). Self-hosted
# instances keep admin-only provisioning by leaving this false.
SELF_SIGNUP_ENABLED=false

# --- Stripe billing (hosted subscriptions) ---
# Live/test keys from the Stripe Dashboard. The webhook secret (whsec_...) is
# shown when the /api/v1/billing/webhook endpoint is registered in Stripe.
# Price IDs come from the Dashboard or scripts/stripe-setup.py. The billing
# endpoints return 503 until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ENTHUSIAST_MONTHLY=
STRIPE_PRICE_ENTHUSIAST_YEARLY=
STRIPE_PRICE_GARAGE_MONTHLY=
STRIPE_PRICE_GARAGE_YEARLY=

# Early-adopter sale (AUT-93): 40% off the first 3 months, first 100
# subscribers, 6 months from launch. Created by scripts/stripe-setup.py; the
# app auto-applies the promo to monthly checkouts while the window is open.
STRIPE_PROMO_EARLY_ADOPTER=
STRIPE_PROMO_EARLY_ADOPTER_CODE=EARLY40
STRIPE_SALE_ENDS_AT=

# --- Licence/upgrade feature ---
# When true the app shows the License page (plans + upgrade). Off for
# demo/default; the hosted instance sets it to true. Sponsored accounts
# (admin re-upgrade, no Stripe sub) are blocked from buying a licence.
LICENSE_ENABLED=false

# --- Store-native in-app purchases (AUT-610/617) ---
# Empty credentials keep IAP disabled; the store builds of the mobile app then
# fall back to the Stripe browser path. Set these via Paperclip secrets on the
# deployment env — never commit the values.
# Google Play: full service-account key JSON for a Play Console service account
# with the "View financial data"/"Manage orders" permission on the app.
IAP_GOOGLE_SERVICE_ACCOUNT_JSON=
IAP_GOOGLE_PACKAGE_NAME=com.autobrainservice.app
# Apple App Store Connect API key (Issuer ID, Key ID, and the .p8 private key).
IAP_APPLE_ISSUER_ID=
IAP_APPLE_KEY_ID=
IAP_APPLE_PRIVATE_KEY=
IAP_APPLE_BUNDLE_ID=com.autobrainservice.app
# How many days before expiry / after expiry /auth/me re-validates the stored
# store purchase token (verify-on-refresh, AUT-617).
IAP_REFRESH_WINDOW_DAYS=2
# Google Play RTDN webhook (Pub/Sub push) OIDC token audience. Empty = derived
# from APP_BASE_URL + the webhook path.
IAP_GOOGLE_PUBSUB_AUDIENCE=
