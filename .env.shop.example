# ============================================================
# AutoBrain Shop environment template
# Copy to .env.shop and fill in real values. Never commit .env.shop.
# ============================================================

# --- Registry ---
REGISTRY=152.69.188.133:5000
IMAGE_TAG=latest

# --- Core ---
PROJECT_NAME=AutoBrain Shop
ENVIRONMENT=production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL ---
POSTGRES_USER=autobrain_shop
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=autobrain_shop

# --- Redis ---
REDIS_PASSWORD=change-me-redis-password

# --- MinIO (S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=autobrain-shop-assets
MINIO_SECURE=true
MINIO_PUBLIC_ENDPOINT=https://shop.autobrainservice.app

# --- AI Router (9Router, stack-local on Oracle VM) ---
AI_ROUTER_URL=http://9router:20128/v1
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=General-Use
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
AI_GATEWAY_API_KEY=change-me-ai-gateway-key

# --- Frontend (build args) ---
API_BASE_URL=https://shop.autobrainservice.app/api/v1
WS_BASE_URL=wss://shop.autobrainservice.app/ws
CARTO_API_KEY=

# --- Rego lookup ---
REGO_LOOKUP_URL=
REGO_LOOKUP_API_KEY=

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@autobrain.io
ADMIN_DISPLAY_NAME=AutoBrain Admin
ADMIN_INITIAL_PASSWORD=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@autobrainservice.app
SMTP_FROM_NAME=AutoBrain

# --- App ---
APP_BASE_URL=https://shop.autobrainservice.app
CORS_ALLOWED_ORIGINS=["https://shop.autobrainservice.app"]
SELF_SIGNUP_ENABLED=true
LICENSE_ENABLED=true

# --- Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ENTHUSIAST_MONTHLY=
STRIPE_PRICE_ENTHUSIAST_YEARLY=
STRIPE_PRICE_GARAGE_MONTHLY=
STRIPE_PRICE_GARAGE_YEARLY=
STRIPE_PROMO_EARLY_ADOPTER=
STRIPE_PROMO_EARLY_ADOPTER_CODE=EARLY40
STRIPE_SALE_ENDS_AT=

# --- Admin API ---
ADMIN_API_KEY=

# --- Dongle server ---
DONGLE_SERVER_API_KEY=

# --- Fuel ---
FUEL_NSW_API_KEY=
FUEL_NSW_API_SECRET=
FUEL_NSW_ENABLED=true
FUEL_VIC_API_KEY=
FUEL_VIC_API_SECRET=
FUEL_VIC_ENABLED=true
FUEL_QLD_API_KEY=
FUEL_SA_API_KEY=
FUEL_SA_ENABLED=true

# --- Federation hub ---
SOCIAL_FEDERATION_HUB_URL=
SOCIAL_FEDERATION_HOSTED=false

# --- In-App Purchase ---
IAP_GOOGLE_SERVICE_ACCOUNT_JSON=
IAP_GOOGLE_PACKAGE_NAME=com.autobrainservice.app
IAP_APPLE_ISSUER_ID=
IAP_APPLE_KEY_ID=
IAP_APPLE_PRIVATE_KEY=
IAP_APPLE_BUNDLE_ID=com.autobrainservice.app

# --- Market data ---
MARKET_DATA_URL=http://ai-gateway:8000
MARKET_DATA_API_KEY=

# --- Paperclip (CI triage) ---
PAPERCLIP_API_URL=https://paperclip.nathanmartina.com
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=41d8aeaf-0e55-4127-b037-7a6d740be3b6
