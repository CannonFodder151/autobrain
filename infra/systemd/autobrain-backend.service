# AutoBrain backend systemd unit (bare-metal fallback, no containers).
# Install: sudo cp autobrain-backend.service /etc/systemd/system/ && sudo systemctl daemon-reload

[Unit]
Description=AutoBrain Backend (FastAPI)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=docker
WorkingDirectory=/opt/autobrain
EnvironmentFile=/opt/autobrain/.env
ExecStart=/usr/local/bin/docker compose exec -T backend uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
